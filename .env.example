# q-one-gym — environment variables
#
# Generated by scanning the source for real read sites (location cited per entry).
# Only variables the code actually reads are listed; standard OS/CI variables are omitted.
# Do not commit real secrets.

# Optional path override for the episode table. When unset, tasks/build_tasks.py
# reads the vendored file data/games.csv (see data/PROVENANCE.md).
# `make check` unsets this variable.
# read at tasks/build_tasks.py
GAMES_CSV=

# Used only by `python3 run.py --llm`. Not read by `make check`. No LLM result is committed.
# read at run.py (Authorization header)
LLM_API_KEY=

# Required for --llm. No default.
# read at run.py (chat/completions URL)
LLM_BASE_URL=

# Default model name when --llm is set and this variable is absent.
# read at run.py
LLM_MODEL=qwen2.5:7b
